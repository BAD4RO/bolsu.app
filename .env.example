# Supabase do ambiente correspondente. Nunca exponha service_role no frontend.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

BOLSU_BILLING_MODE=test
BOLSU_APP_URL=http://localhost:3000
# Opcional: UUIDs separados por vírgula. Vazio permite qualquer usuário autenticado no teste.
BOLSU_BILLING_TEST_USER_IDS=
STRIPE_SECRET_KEY=
# Opcional: Checkout hospedado redireciona por URL e não usa Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_1UIPHiExpt1yPVMT2EZnZDDf
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_1UIPIKExpt1yPVMTKigwYIdu
STRIPE_WEBHOOK_SECRET=
BOLSU_BILLING_RECONCILE_SECRET=
